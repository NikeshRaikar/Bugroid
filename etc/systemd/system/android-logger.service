[Unit]
Description=Android Logger Service
After=network.target

[Service]
Type=simple

User=renault
Group=renault

WorkingDirectory=/opt/logroid

ExecStart=/usr/bin/python3 \
    /opt/logroid/main.py

Restart=always
RestartSec=10

KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target